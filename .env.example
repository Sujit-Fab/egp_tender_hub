# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
APP_URL=

# SMTP Configuration for Support Desk (Nodemailer)
# Configure these in the AI Studio Settings (Secrets)
SMTP_HOST=smtp.egptenderhub.com
SMTP_PORT=465
SMTP_USER=support@egptenderhub.com
SMTP_PASS=


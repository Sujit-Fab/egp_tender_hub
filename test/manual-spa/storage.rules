// Manual demo only. No production Storage rules are supplied by this repository.
// This policy is not evidence of production Storage authorization behavior.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /stds/{file} {
      allow read, write: if request.auth != null;
    }
    match /{path=**} { allow read, write: if false; }
  }
}

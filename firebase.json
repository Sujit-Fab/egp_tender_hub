{
  "firestore": [
    {
      "database": "ai-studio-7e6a1daf-95b8-46d0-a6ba-7cf295cd1701",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": ["node scripts/tender-radar/build-runtime.mjs"]
  }
}
